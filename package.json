{
  "name": "wholesale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:gcs": "node scripts/test-gcs-upload.mjs",
    "test:low-stock": "node --experimental-strip-types lib/inventory/lowStock.test.ts",
    "test:purchase-reports": "node --experimental-strip-types lib/inventory/purchaseReports.test.ts",
    "test:product-purchase-stats": "node --experimental-strip-types lib/inventory/productPurchaseStats.test.ts",
    "test:loans": "node --experimental-strip-types lib/finance/loanBalances.test.ts",
    "test:engagement": "node --experimental-strip-types lib/customers/customerEngagement.test.ts",
    "test:delivery-balance": "node --experimental-strip-types lib/invoices/deliveryBalanceList.test.ts",
    "test:counter-sale": "node --experimental-strip-types lib/invoices/counterSaleCalculations.test.ts",
    "test:social": "node --experimental-strip-types --test lib/social/suggestionRanking.test.ts lib/social/weekKeys.test.ts lib/social/postTypes.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project wholesale-rules-test \"node --test test/rules/social.rules.test.mjs\"",
    "test:rules:inventory": "firebase emulators:exec --only firestore --project wholesale-rules-test \"node --test test/rules/inventory-ledger.rules.test.mjs\"",
    "test:rules:all": "firebase emulators:exec --only firestore --project wholesale-rules-test \"node --test test/rules/social.rules.test.mjs test/rules/inventory-ledger.rules.test.mjs\"",
    "test:reconcile-plan": "node --experimental-strip-types --test lib/inventory/reconciliationPlan.test.ts",
    "test:inventory-reconcile": "firebase emulators:exec --only firestore --project wholesale-rules-test \"node --import ./scripts/support/registerTsAlias.mjs --test test/inventory/reconcileMismatch.emulator.test.mjs\"",
    "validate:inventory": "node --import ./scripts/support/registerTsAlias.mjs scripts/inventory/validate.mjs",
    "reconcile:book-stock": "node scripts/inventory/reconcile-book-stock.mjs",
    "reconcile:mismatch": "node --import ./scripts/support/registerTsAlias.mjs scripts/inventory/reconcile-mismatch.mjs",
    "validate:inventory:nightly": "node scripts/inventory/nightly-validate.mjs",
    "inventory:export-baseline": "node scripts/inventory/export-baseline.mjs",
    "test:inventory-invariants": "node --experimental-strip-types --test lib/inventory/invariants.test.ts",
    "test:inventory-validation": "node --experimental-strip-types --import ./scripts/support/registerTsAlias.mjs lib/inventory/validateInventory.test.ts",
    "test:inventory-parity": "node --experimental-strip-types --import ./scripts/support/registerTsAlias.mjs lib/inventory/inventoryParity.test.ts",
    "test:inventory-stress": "node --experimental-strip-types lib/inventory/inventoryConcurrency.test.ts",
    "migrate:inventory": "node scripts/migrations/run.mjs",
    "deploy:firestore-rules": "firebase deploy --only firestore:rules",
    "deploy:firestore-indexes": "firebase deploy --only firestore:indexes"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "firebase": "^12.11.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "next": "^16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "firebase-admin": "^13.7.0",
    "firebase-tools": "^14.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
